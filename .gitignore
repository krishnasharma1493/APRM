# --- Build output (C) --------------------------------------------------------
# make, make debug, make sanitize, make test write everything under build/.
build/
*.o
*.a
*.d
*.dSYM/
/aprm

# --- Website build -----------------------------------------------------------
# make wasm writes the engine bundle; make web installs npm packages and writes
# the one-file site. The engine bundle is committed only on the demo-ready tag
# (git add -f web/vendor/aprm.js).
web/vendor/aprm.js
web/vendor/*.wasm
web/node_modules/
web/dist/

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Experiment output -------------------------------------------------------
# tools/run_experiments.py and tools/summarize.py write here; regenerate with
# the commands in README.md.
results/


# --- Editor and OS caches ----------------------------------------------------
# Shared VS Code settings stay committed.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Tool folders -----------------------------------------------------------
# Local working state of the design tool and the browser tool, and the old
# run script and its state.
.impeccable/
.playwright-mcp/
autorun.sh
.autorun/

# --- Local project documents -----------------------------------------------
# Planning documents, design notes, research papers and report figures are kept on the developers' machines only, not in the
# public repository. tools/plot_figures.py still writes to docs/report/figures/.
docs/
deploy/
.vercel/
